{
  "name": "wemove-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check:architecture": "tsx scripts/check-architecture.ts",
    "check:database": "tsx scripts/check-no-physical-foreign-keys.ts",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:requirements": "tsx scripts/check-requirements-coverage.ts",
    "check": "pnpm check:requirements && pnpm check:architecture && pnpm check:database && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
