  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@unique([entityType, entityId, locale, market, ruleCode])
  @@index([status, severity, createdAt])
  @@index([entityType, entityId])
  @@map("seo_audit_findings")
}

model NotFoundEvent {
  id          Int      @id @default(autoincrement())
  path        String
  referrer    String?
  market      String?
  locale      String?
  userId      Int?     @map("user_id")
  requestId   String?  @map("request_id")
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @updatedAt @map("last_seen_at")

  @@index([path, market, locale])
  @@index([lastSeenAt])
  @@map("not_found_events")
}

model Redirect {
  id         Int      @id @default(autoincrement())
  sourcePath String   @unique @map("source_path")
  targetPath String   @map("target_path")
  statusCode Int      @default(301) @map("status_code")
  market     String?
  locale     String?
  isActive   Boolean  @default(true) @map("is_active")
  hitCount   Int      @default(0) @map("hit_count")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([targetPath])
  @@index([market, locale, isActive])
  @@map("redirects")
}

// -----------------------------------------------------------------------------
// Platform, localization, search, jobs and observability
// -----------------------------------------------------------------------------

model Locale {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  nativeName String?  @map("native_name")
  direction  String   @default("ltr")
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("locales")
}

// Kept for compatibility with the existing localization API while Locale is
// used by the expanded platform model.
model Language {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  label       String
  nativeLabel String   @map("native_label")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("languages")
}

model Market {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  name             String?
  defaultLocale    String   @map("default_locale")
  defaultLocaleId  Int?     @map("default_locale_id")
  countryCodes     Json?    @map("country_codes")
  supportedLocales Json?    @map("supported_locales")
  currency         String
  timezone         String
  settings         Json
  b2cEnabled       Boolean  @default(false) @map("b2c_enabled")
  b2bEnabled       Boolean  @default(true) @map("b2b_enabled")
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([status, code])
  @@index([defaultLocaleId])
  @@map("markets")
}

model MarketLocale {
  id         Int      @id @default(autoincrement())
  marketId   Int      @map("market_id")
  languageId Int      @map("language_id")
  locale     String
  pathPrefix String   @map("path_prefix")
  localeId   Int?     @map("locale_id")
  isDefault  Boolean  @default(false) @map("is_default")
  sortOrder  Int      @default(0) @map("sort_order")
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([marketId, locale])
  @@unique([marketId, pathPrefix])
  @@unique([marketId, localeId])
  @@index([marketId, status, sortOrder])
  @@index([marketId, isDefault, status])
  @@index([languageId])
  @@index([localeId])
  @@map("market_locales")
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("favorites")
}

model Subscription {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  channel        String
  email          String?
  source         String?
  status         String    @default("active")
  consentAt      DateTime? @map("consent_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([userId, channel])
  @@index([userId])
  @@index([channel, status])
  @@index([userId, status])
  @@map("subscriptions")
}

model FeatureFlag {
  id             Int      @id @default(autoincrement())
  key            String   @unique
  description    String?
  defaultEnabled Boolean  @default(false) @map("default_enabled")
  targeting      Json?
  status         String   @default("active")
  createdBy      Int?     @map("created_by")
  updatedBy      Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("feature_flags")
}

model NotificationTemplate {
  id          Int      @id @default(autoincrement())
  templateKey String   @map("template_key")
  locale      String
  channel     String
  version     Int      @default(1)
  subject     String?
  body        String
  variables   Json
  status      String   @default("draft")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([templateKey, locale, channel, version])
  @@index([templateKey, locale, channel, status])
  @@map("notification_templates")
}

model NotificationDelivery {
  id              Int       @id @default(autoincrement())
  userId          Int?      @map("user_id")
  companyId       Int?      @map("company_id")
  templateKey     String    @map("template_key")
  templateVersion Int?      @map("template_version")
  locale          String?
  channel         String
  status          String
  payload         Json
  entityType      String?   @map("entity_type")
  entityId        Int?      @map("entity_id")
  providerId      String?   @map("provider_id")
  idempotencyKey  String?   @unique @map("idempotency_key")
  attempts        Int       @default(0)
  failureReason   String?   @map("failure_reason")
  nextRetryAt     DateTime? @map("next_retry_at")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([companyId, status])
  @@index([templateKey, createdAt])
  @@index([status, nextRetryAt])
  @@index([entityType, entityId])
  @@map("notification_deliveries")
}

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  eventKey   String   @unique @map("event_key")
  name       String
  requestId  String   @map("request_id")
  sessionId  String?  @map("session_id")
  userId     Int?     @map("user_id")
  companyId  Int?     @map("company_id")
  productId  Int?     @map("product_id")
  variantId  Int?     @map("variant_id")
  orderId    Int?     @map("order_id")
  market     String?
  locale     String?
  device     String?
  source     String?
  payload    Json
  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@index([companyId, occurredAt])
  @@index([productId, occurredAt])
  @@index([orderId])
  @@map("analytics_events")
}

model SearchSynonym {
  id        Int      @id @default(autoincrement())
  term      String
  synonyms  Json
  locale    String?
  market    String?
  status    String   @default("active")
  createdBy Int?     @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([term, locale, market])
  @@index([market, locale, status])
  @@map("search_synonyms")
}

model SearchQueryLog {
  id              Int      @id @default(autoincrement())
  query           String
  normalizedQuery String   @map("normalized_query")
  resultsCount    Int      @map("results_count")
  userId          Int?     @map("user_id")
  companyId       Int?     @map("company_id")
  market          String?
  locale          String?
  requestId       String?  @map("request_id")
  clicked         Boolean  @default(false)
  converted       Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([normalizedQuery, createdAt])
  @@index([resultsCount, createdAt])
  @@index([userId, createdAt])
  @@index([companyId, createdAt])
  @@map("search_query_logs")
}

model JobRun {
  id             Int       @id @default(autoincrement())
  jobKey         String    @map("job_key")
  runNo          String    @unique @map("run_no")
  idempotencyKey String?   @unique @map("idempotency_key")
  status         String    @default("queued")
  requestedBy    Int?      @map("requested_by")
  requestId      String?   @map("request_id")
  totalItems     Int       @default(0) @map("total_items")
  succeededItems Int       @default(0) @map("succeeded_items")
  failedItems    Int       @default(0) @map("failed_items")
  attempts       Int       @default(0)
  errorMessage   String?   @map("error_message")
  queuedAt       DateTime  @default(now()) @map("queued_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([jobKey, status, queuedAt])
  @@index([status, queuedAt])
  @@index([requestedBy, queuedAt])
  @@map("job_runs")
}

model JobItem {
  id           Int       @id @default(autoincrement())
  jobRunId     Int       @map("job_run_id")
  itemKey      String    @map("item_key")
  status       String    @default("pending")
  attempts     Int       @default(0)
  payload      Json?
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([jobRunId, itemKey])
  @@index([jobRunId, status])
  @@index([status, updatedAt])
  @@map("job_items")
}

model IntegrationConfig {
  id             Int      @id @default(autoincrement())
  integrationKey String   @unique @map("integration_key")
  provider       String
  environment    String
  secretRef      String?  @map("secret_ref")
  config         Json
  status         String   @default("inactive")
  updatedBy      Int?     @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([provider, environment, status])
  @@map("integration_configs")
}

model WebhookReceipt {
  id              Int       @id @default(autoincrement())
  provider        String
  externalEventId String    @map("external_event_id")
  eventType       String    @map("event_type")
  signatureHash   String?   @map("signature_hash")
  payload         Json
  status          String    @default("received")
  aggregateType   String?   @map("aggregate_type")
  aggregateId     Int?      @map("aggregate_id")
  requestId       String?   @map("request_id")
  retryCount      Int       @default(0) @map("retry_count")
  failureReason   String?   @map("failure_reason")
  receivedAt      DateTime  @default(now()) @map("received_at")
  processedAt     DateTime? @map("processed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@index([aggregateType, aggregateId])
  @@map("webhook_receipts")
}

model ReportSnapshot {
  id          Int      @id @default(autoincrement())
  reportKey   String   @map("report_key")
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  market      String?
  dimensions  Json
  metrics     Json
  status      String   @default("ready")
  generatedBy Int?     @map("generated_by")
  generatedAt DateTime @default(now()) @map("generated_at")

  @@unique([reportKey, periodStart, periodEnd, market])
  @@index([reportKey, periodEnd])
  @@index([market, periodEnd])
  @@map("report_snapshots")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  groupName   String   @map("group_name")
  key         String
  value       Json
  version     String
  environment String   @default("default")
  description String?
  isSecretRef Boolean  @default(false) @map("is_secret_ref")
  updatedBy   Int?     @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([groupName, key])
  @@unique([groupName, key, environment])
  @@index([updatedBy])
  @@map("system_settings")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?     @map("actor_id")
  actorType String?  @map("actor_type")
  action    String
  entity    String
  entityId  Int      @map("entity_id")
  before    Json?
  after     Json?
  metadata  Json?
  outcome   String   @default("success")
  ip        String?
  requestId String   @map("request_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, outcome, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model OutboxEvent {
  id             Int       @id @default(autoincrement())
  eventId        String    @unique @map("event_id")
  topic          String
  aggregateType  String    @map("aggregate_type")
  aggregateId    Int       @map("aggregate_id")
  payload        Json
  idempotencyKey String?   @unique @map("idempotency_key")
  status         String    @default("pending")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  requestId      String?   @map("request_id")
  availableAt    DateTime  @default(now()) @map("available_at")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([status, availableAt])
  @@index([aggregateId])
  @@index([aggregateType, aggregateId])
  @@index([topic, createdAt])
  @@map("outbox_events")
}
