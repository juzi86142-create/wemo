generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// 跨表只保存整数逻辑 ID；关联存在性、权限边界和生命周期由应用事务维护。

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String
  phone             String?
  locale            String    @default("en-US")
  status            String    @default("pending_verification")
  verifiedAt        DateTime? @map("verified_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  archivedAt        DateTime? @map("archived_at")

  @@index([status, createdAt])
  @@index([archivedAt])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  audience    String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([audience, status])
  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  module      String
  action      String
  name        String
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([module, action])
  @@index([module, status])
  @@map("permissions")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  effect       String   @default("allow")
  assignedBy   Int?     @map("assigned_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  roleId     Int       @map("role_id")
  overrides  Json
  status     String    @default("active")
  assignedBy Int?      @map("assigned_by")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@unique([userId, roleId])
  @@index([userId])
  @@index([userId, status])
  @@index([roleId])
  @@map("user_roles")
}

model UserPermission {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  permissionId Int       @map("permission_id")
  effect       String    @default("allow")
  assignedBy   Int?      @map("assigned_by")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@unique([userId, permissionId])
  @@index([userId, expiresAt])
  @@index([permissionId])
  @@map("user_permissions")
}

model Address {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  kind          String
  label         String?
  recipientName String?   @map("recipient_name")
  phone         String?
  country       String?
  region        String?
  city          String?
  postalCode    String?   @map("postal_code")
  line1         String?
  line2         String?
  payload       Json
  isDefault     Boolean   @default(false) @map("is_default")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  archivedAt    DateTime? @map("archived_at")

  @@index([userId])
  @@index([userId, kind, archivedAt])
  @@map("addresses")
}

model Session {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  sessionTokenHash String    @unique @map("session_token_hash")
  audience         String
  userAgent        String?   @map("user_agent")
  ip               String?
  expiresAt        DateTime  @map("expires_at")
  lastSeenAt       DateTime? @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason")

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@index([audience, expiresAt])
  @@map("sessions")
}

model AuthChallenge {
  id         Int       @id @default(autoincrement())
  userId     Int?      @map("user_id")
  email      String?
  type       String
  tokenHash  String    @unique @map("token_hash")
  payload    Json?
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, type, expiresAt])
  @@index([email, type, expiresAt])
  @@map("auth_challenges")
}

model MfaFactor {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  type       String
  label      String?
  secretRef  String?   @map("secret_ref")
  publicKey  String?   @map("public_key")
  status     String    @default("pending")
  verifiedAt DateTime? @map("verified_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId, status])
  @@map("mfa_factors")
}

model ConsentRecord {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  email       String?
  consentType String    @map("consent_type")
  version     String
  granted     Boolean
  source      String
  locale      String?
  ip          String?
  userAgent   String?   @map("user_agent")
  recordedAt  DateTime  @default(now()) @map("recorded_at")
  withdrawnAt DateTime? @map("withdrawn_at")

  @@index([userId, consentType, recordedAt])
  @@index([email, consentType, recordedAt])
  @@map("consent_records")
}

model PrivacyRequest {
  id          Int       @id @default(autoincrement())
  requestNo   String    @unique @map("request_no")
  userId      Int       @map("user_id")
  type        String
  status      String    @default("requested")
  requestedAt DateTime  @default(now()) @map("requested_at")
  completedAt DateTime? @map("completed_at")
  completedBy Int?      @map("completed_by")
  resultRef   String?   @map("result_ref")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([status, requestedAt])
  @@map("privacy_requests")
}

model UserStatusHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  reason     String?
  changedBy  Int?     @map("changed_by")
  requestId  String?  @map("request_id")
  changedAt  DateTime @default(now()) @map("changed_at")

  @@index([userId, changedAt])
  @@index([toStatus, changedAt])
  @@map("user_status_history")
}

// -----------------------------------------------------------------------------
// Dealers
// -----------------------------------------------------------------------------

model DealerTier {
  id                 Int       @id @default(autoincrement())
  code               String    @unique
  name               String
  rank               Int       @default(0)
  defaultPriceListId Int?      @map("default_price_list_id")
  discountRules      Json
  status             String    @default("active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  archivedAt         DateTime? @map("archived_at")

  @@index([status, rank])
  @@map("dealer_tiers")
}

model DealerApplication {
  id                      Int       @id @default(autoincrement())
  applicationNo           String    @unique @map("application_no")
  applicantUserId         Int?      @map("applicant_user_id")
  legalName               String    @map("legal_name")
  country                 String
  contactName             String?   @map("contact_name")
  contactEmail            String    @map("contact_email")
  contactPhone            String?   @map("contact_phone")
  businessType            String?   @map("business_type")
  website                 String?
  taxId                   String?   @map("tax_id")
  paymentTerms            Json?     @map("payment_terms")
  salesTerritories        Json?     @map("sales_territories")
  authorizedCategories    Json?     @map("authorized_categories")
  estimatedAnnualPurchase String?   @map("estimated_annual_purchase")
  interestedProducts      Json?     @map("interested_products")
  existingBrands          Json?     @map("existing_brands")
  payload                 Json
  status                  String    @default("draft")
  submittedAt             DateTime? @map("submitted_at")
  reviewedAt              DateTime? @map("reviewed_at")
  reviewedBy              Int?      @map("reviewed_by")
  approvedAt              DateTime? @map("approved_at")
  rejectionReason         String?   @map("rejection_reason")
  lastSavedAt             DateTime? @map("last_saved_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([status, country])
  @@index([applicantUserId])
  @@index([contactEmail, status])
  @@map("dealer_applications")
}

model DealerApplicationAttachment {
  id               Int       @id @default(autoincrement())
  applicationId    Int       @map("application_id")
  mediaAssetId     Int       @map("media_asset_id")
  kind             String
  fileNameSnapshot String?   @map("file_name_snapshot")
  status           String    @default("active")
  uploadedBy       Int?      @map("uploaded_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  archivedAt       DateTime? @map("archived_at")

  @@index([applicationId, status])
  @@index([mediaAssetId])
  @@map("dealer_application_attachments")
}

model DealerApplicationConsent {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  consentType   String   @map("consent_type")
  version       String
  accepted      Boolean
  acceptedAt    DateTime @default(now()) @map("accepted_at")
  ip            String?
  userAgent     String?  @map("user_agent")

  @@unique([applicationId, consentType, version])
  @@index([applicationId])
  @@map("dealer_application_consents")
}

model DealerApplicationReview {
  id            Int      @id @default(autoincrement())
  applicationId Int      @map("application_id")
  reviewerId    Int?     @map("reviewer_id")
  fromStatus    String?  @map("from_status")
  toStatus      String   @map("to_status")
  decision      String
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("dealer_application_reviews")
}

model DealerSupplementRequest {
  id            Int       @id @default(autoincrement())
  applicationId Int       @map("application_id")
  requestedBy   Int?      @map("requested_by")
  status        String    @default("open")
  message       String
  dueAt         DateTime? @map("due_at")
  respondedAt   DateTime? @map("responded_at")
  response      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([applicationId, status])
  @@index([status, dueAt])
  @@map("dealer_supplement_requests")
}

model DealerCompany {
  id                   Int       @id @default(autoincrement())
  applicationId        Int?      @map("application_id")
  legalName            String    @map("legal_name")
  displayName          String    @map("display_name")
  country              String
  website              String?
  businessType         String?   @map("business_type")
  taxId                String?   @map("tax_id")
  tierId               Int?      @map("tier_id")
  priceListId          Int?      @map("price_list_id")
  salesRepId           Int?      @map("sales_rep_id")
  currency             String
  paymentTerms         Json?     @map("payment_terms")
  salesTerritories     Json?     @map("sales_territories")
  authorizedCategories Json?     @map("authorized_categories")
  terms                Json
  logoMediaAssetId     Int?      @map("logo_media_asset_id")
  primaryUserId        Int?      @map("primary_user_id")
  publicListing        Boolean   @default(false) @map("public_listing")
  status               String    @default("active")
  openedAt             DateTime? @map("opened_at")
  suspendedAt          DateTime? @map("suspended_at")
  closedAt             DateTime? @map("closed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  archivedAt           DateTime? @map("archived_at")

  @@index([status, country])
  @@index([tierId])
  @@index([priceListId])
  @@index([salesRepId, status])
  @@index([primaryUserId])
  @@index([publicListing, status])
  @@map("dealer_companies")
}

model DealerCompanyStatusHistory {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  reason     String?
  changedBy  Int?     @map("changed_by")
  requestId  String?  @map("request_id")
  changedAt  DateTime @default(now()) @map("changed_at")

  @@index([companyId, changedAt])
  @@index([toStatus, changedAt])
  @@map("dealer_company_status_history")
}

model DealerMember {
  id          Int       @id @default(autoincrement())
  companyId   Int       @map("company_id")
  userId      Int       @map("user_id")
  role        String
  permissions Json
  status      String    @default("active")
  invitedBy   Int?      @map("invited_by")
  invitedAt   DateTime? @map("invited_at")
  joinedAt    DateTime? @map("joined_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([companyId, status])
  @@index([userId])
  @@index([userId, status])
  @@map("dealer_members")
}

model DealerInvitation {
  id         Int       @id @default(autoincrement())
  companyId  Int       @map("company_id")
  email      String
  role       String
  tokenHash  String    @unique @map("token_hash")
  invitedBy  Int?      @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  acceptedBy Int?      @map("accepted_by")
  status     String    @default("pending")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([companyId, status])
  @@index([email, status])
  @@map("dealer_invitations")
}

model DealerAuthorization {
  id                Int       @id @default(autoincrement())
  companyId         Int       @map("company_id")
  categoryId        Int?      @map("category_id")
  market            String?
  territory         String?
  authorizationType String    @map("authorization_type")
  status            String    @default("active")
  validFrom         DateTime? @map("valid_from")
  validTo           DateTime? @map("valid_to")
  rules             Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@index([categoryId, market, status])
  @@map("dealer_authorizations")
}

model DealerAgreement {
  id            Int       @id @default(autoincrement())
  companyId     Int       @map("company_id")
  agreementType String    @map("agreement_type")
  version       String
  contentHash   String?   @map("content_hash")
  acceptedBy    Int?      @map("accepted_by")
  acceptedAt    DateTime? @map("accepted_at")
  ip            String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([companyId, agreementType, version])
  @@index([companyId, status])
  @@map("dealer_agreements")
}

model DealerAddress {
  id            Int       @id @default(autoincrement())
  companyId     Int       @map("company_id")
  kind          String
  label         String?
  recipientName String?   @map("recipient_name")
  phone         String?
  country       String?
  region        String?
  city          String?
  postalCode    String?   @map("postal_code")
  line1         String?
  line2         String?
  payload       Json
  publicListing Json?     @map("public_listing")
  isDefault     Boolean   @default(false) @map("is_default")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  archivedAt    DateTime? @map("archived_at")

  @@index([companyId])
  @@index([companyId, kind, status])
  @@map("dealer_addresses")
}

model DealerStore {
  id                   Int      @id @default(autoincrement())
  companyId            Int      @map("company_id")
  name                 String
  storeType            String?  @map("store_type")
  country              String?
  region               String?
  city                 String?
  address              String?
  phone                String?
  website              String?
  businessHours        Json?    @map("business_hours")
  latitude             Float?
  longitude            Float?
  authorizedCategories Json?    @map("authorized_categories")
  publicListing        Boolean  @default(true) @map("public_listing")
  status               String   @default("active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([companyId, status])
  @@index([country, region, city, publicListing])
  @@map("dealer_stores")
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------

model Category {
  id               Int       @id @default(autoincrement())
  parentId         Int?      @map("parent_id")
  code             String?   @unique
  slug             String    @unique
  status           String    @default("active")
  sortOrder        Int       @default(0) @map("sort_order")
  localizedContent Json      @map("localized_content")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  archivedAt       DateTime? @map("archived_at")

  @@index([parentId])
  @@index([parentId, status, sortOrder])
  @@map("categories")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  locale      String
  market      String
  slug        String
  name        String
  description String?
  status      String   @default("published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([market, locale, slug])
  @@unique([categoryId, market, locale])
  @@index([categoryId])
  @@map("category_translations")
}

model AttributeDefinition {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  dataType   String   @map("data_type")
  unit       String?
  options    Json?
  filterable Boolean  @default(false)
  sortable   Boolean  @default(false)
  searchable Boolean  @default(false)
  required   Boolean  @default(false)
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([filterable, status])
  @@map("attribute_definitions")
}

model CategoryAttribute {
  id                    Int     @id @default(autoincrement())
  categoryId            Int     @map("category_id")
  attributeDefinitionId Int     @map("attribute_definition_id")
  sortOrder             Int     @default(0) @map("sort_order")
  required              Boolean @default(false)
  config                Json?

  @@unique([categoryId, attributeDefinitionId])
  @@index([categoryId, sortOrder])
  @@index([attributeDefinitionId])
  @@map("category_attributes")
}

model Tag {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  tagType   String?  @map("tag_type")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tags")
}

model TagTranslation {
  id        Int      @id @default(autoincrement())
  tagId     Int      @map("tag_id")
  locale    String
  market    String
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tagId, locale, market])
  @@index([locale, market, name])
  @@map("tag_translations")
}

model Product {
  id                Int       @id @default(autoincrement())
  primaryCategoryId Int       @map("primary_category_id")
  name              String    @default("")
  slug              String    @default("")
  status            String    @default("draft")
  ageMin            Int?      @map("age_min")
  ageMax            Int?      @map("age_max")
  playEnvironment   Json?     @map("play_environment")
  skills            Json?
  shortDescription  String?   @map("short_description")
  longDescription   Json?     @map("long_description")
  features          Json?
  materials         Json?
  productDimensions Json?     @map("product_dimensions")
  packageDimensions Json?     @map("package_dimensions")
  netWeight         Int?      @map("net_weight")
  grossWeight       Int?      @map("gross_weight")
  weightUnit        String?   @map("weight_unit")
  casePack          Int?      @map("case_pack")
  moq               Int?      @map("moq")
  includedItems     Json?     @map("included_items")
  safetyNotes       Json?     @map("safety_notes")
  attributes        Json
  seo               Json?
  marketVisibility  Json      @map("market_visibility")
  publishedAt       DateTime? @map("published_at")
  scheduledAt       DateTime? @map("scheduled_at")
  createdBy         Int?      @map("created_by")
  updatedBy         Int?      @map("updated_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  archivedAt        DateTime? @map("archived_at")

  @@index([status, primaryCategoryId])
  @@index([status, publishedAt])
  @@index([ageMin, ageMax])
  @@index([slug])
  @@map("products")
}

model ProductTranslation {
  id                Int       @id @default(autoincrement())
  productId         Int       @map("product_id")
  locale            String
  market            String
  slug              String
  name              String
  shortDescription  String    @map("short_description")
  longDescription   Json?     @map("long_description")
  content           Json
  features          Json?
  seo               Json?
  translationStatus String    @default("not_started") @map("translation_status")
  publishedAt       DateTime? @map("published_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([market, locale, slug])
  @@unique([productId, market, locale])
  @@index([productId])
  @@index([translationStatus])
  @@map("product_translations")
}

model Variant {
  id                Int       @id @default(autoincrement())
  productId         Int       @map("product_id")
  sku               String    @unique
  barcode           String?   @unique
  name              String?
  options           Json
  specifications    Json
  weight            Int?
  weightUnit        String?   @map("weight_unit")
  dimensions        Json?
  packageDimensions Json?     @map("package_dimensions")
  casePack          Int?      @map("case_pack")
  moq               Int?      @map("moq")
  leadTimeDays      Int?      @map("lead_time_days")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  archivedAt        DateTime? @map("archived_at")

  @@index([productId])
  @@index([productId, status])
  @@index([barcode])
  @@map("variants")
}

model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  categoryId Int      @map("category_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([productId, categoryId])
  @@index([categoryId, sortOrder])
  @@index([productId, isPrimary])
  @@map("product_categories")
}

model ProductTag {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  tagId     Int      @map("tag_id")
